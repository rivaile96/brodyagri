{
  "name": "brodyagri-monorepo",
  "private": true,
  "scripts": {
    "dev:tanam": "npm run dev --workspace=apps/tanam",
    "dev:mayur": "npm run dev --workspace=apps/mayur",
    "build:tanam": "npm run build --workspace=apps/tanam",
    "build:mayur": "npm run build --workspace=apps/mayur",
    "build": "npm run build:tanam && npm run build:mayur"
  },
  "workspaces": [
    "apps/*"
  ]
}
